# Copy to .env.test. Used when NODE_ENV=test (the e2e suites set their own
# values in-process and need no file). Razorpay TEST keys only.
NODE_ENV=test
PORT=5101
LOG_LEVEL=warn
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=tirvona_ride_test
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MATCHING_SWEEP_INTERVAL_MS=0
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RECONCILE_INTERVAL_MS=0
DEFAULT_COMMISSION_PERCENT=20
EARNINGS_HOLD_HOURS=0
