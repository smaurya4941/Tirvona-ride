# Copy to .env.production on the server only (never commit it). Prefer the
# host's secret manager; real environment variables override this file.
NODE_ENV=production
HOST=0.0.0.0
PORT=5100
LOG_LEVEL=info
SWAGGER_ENABLED=false
TRUST_PROXY=true
CORS_ORIGINS=https://ride-admin.tirvona.com
MONGODB_URI=
MONGODB_DB_NAME=tirvona_ride
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
APP_TIME_ZONE=Asia/Kolkata
# Live keys — required in production unless PAYMENTS_ENABLED=false (no
# Razorpay account yet: payment endpoints then answer 503).
PAYMENTS_ENABLED=true
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RECONCILE_INTERVAL_MS=60000
DEFAULT_COMMISSION_PERCENT=20
EARNINGS_HOLD_HOURS=0
# Phase 5 — required: public HTTPS origin (share-ride links).
PUBLIC_BASE_URL=https://ride-api.tirvona.com
# Push (recommended): the service-account JSON, base64-encoded.
FIREBASE_SERVICE_ACCOUNT_BASE64=
