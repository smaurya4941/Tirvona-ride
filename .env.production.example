# Copy to .env.production on the server only (never commit it). Prefer the
# host's secret manager; real environment variables override this file.
NODE_ENV=production
HOST=0.0.0.0
PORT=5100
LOG_LEVEL=info
SWAGGER_ENABLED=false
TRUST_PROXY=true
CORS_ORIGINS=https://ride-admin.tirvona.com
MONGODB_URI=
MONGODB_DB_NAME=tirvona_ride
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
APP_TIME_ZONE=Asia/Kolkata
# Live keys — required in production unless PAYMENTS_ENABLED=false (no
# Razorpay account yet: payment endpoints then answer 503).
PAYMENTS_ENABLED=true
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RECONCILE_INTERVAL_MS=60000
PAYMENT_DAILY_RECONCILIATION=true
FINAL_FARE_MODE=actual
FINAL_FARE_MAX_ESTIMATE_MULTIPLIER=1.5
DEFAULT_COMMISSION_PERCENT=20
EARNINGS_HOLD_HOURS=0
# Phase 5 — required: public HTTPS origin (share-ride links).
PUBLIC_BASE_URL=https://ride-api.tirvona.com
# Legal pages for Google Play (privacy policy / account deletion): required.
LEGAL_ENTITY_NAME=…
SUPPORT_EMAIL=…
SUPPORT_PHONE=…
# Push (recommended): the service-account JSON, base64-encoded.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Signup OTP — required: real WhatsApp sender (Meta Cloud API) + HMAC key.
WHATSAPP_PROVIDER=meta
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=tirvona_signup_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE_CODE_BUTTON=true
OTP_TTL_SECONDS=300
OTP_HASH_SECRET=
